# Copiá este archivo como .env y completá los valores.
# Cualquier variable vacía se tolera: la sección o el enlace correspondiente simplemente no se muestra.

# ---- Privadas (solo dev/build, nunca llegan al navegador) ----

# Token de GitHub para leer los repos fijados (API GraphQL).
# No lleva prefijo VITE_: solo lo usa el plugin de Vite en Node.
# Crealo en https://github.com/settings/personal-access-tokens/new
#   - Tipo "Fine-grained", acceso "Public repositories (read-only)"
#   - No necesita ningún permiso extra
GITHUB_TOKEN=

# ---- Públicas (prefijo VITE_: se incluyen en el sitio publicado) ----

# Usuario de GitHub: repos fijados, calendario de contribuciones y enlace al perfil
VITE_GITHUB_USER=

# Email del botón "Escribime" (mailto)
VITE_CONTACT_EMAIL=

# URL completa del perfil de LinkedIn, ej: https://www.linkedin.com/in/tu-usuario/
VITE_LINKEDIN_URL=
